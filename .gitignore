# ---------------------------------------------------------------
# Mereu ignorate: și în repo-ul-șablon, și în repo-urile firmelor
# ---------------------------------------------------------------

# Zona de fișiere de lucru: folderul există după clonare (.gitkeep), dar ce se pune
# în el (tabele, documente, poze) e personal și nu ajunge niciodată în git.
/my-context/assets/*
!/my-context/assets/.gitkeep

# Task-urile sunt personale: fiecare utilizator își are propriul TASKS.md local,
# care nu se publică niciodată (nici în repo-urile firmelor).
/my-context/TASKS.md

# Chei API / secrete: niciodată în git. .env.example rămâne urmărit, ca oricine
# să știe ce variabile sunt așteptate.
/.env
/.env.*
!/.env.example

# Setările Claude Code doar pentru acest calculator.
/.claude/settings.local.json

# Adaptarea pentru Codex: AGENTS.md și skill-urile convertite se generează local de skill-ul
# adapt-to-codex din CLAUDE.md și .claude/skills/. Singurul livrat în repo e adapt-to-codex.
/AGENTS.md
/.agents/skills/*
!/.agents/skills/adapt-to-codex/
/.agents/.adapted-manifest.txt

# Biroul 3D: starea sesiunilor și datele generate de .claude/hooks/explorer-live.py.
# Se rescriu la fiecare pas; sunt locale.
/explorer/live/

# Pagină cu date reale despre oameni, hardcodate în HTML; nu e unealtă generică.
/team-stats.html

.DS_Store

# >>> AISPACE-TEMPLATE-ONLY
# Doar în repo-ul-șablon: contextul unei firme (profil, oameni, proiecte, procese,
# skill-uri învățate) nu intră aici. Într-un repo creat din șablon, /install rulează
# scripts/firm-mode.sh, care șterge tot blocul ăsta, ca firma să-și publice contextul.
# Nu edita marcajele: scriptul le caută exact.
/my-context/*
!/my-context/assets/
/team/*
!/team/skills/
/team/skills/*
!/team/skills/.gitkeep
/.claude/template-manifest.txt
# <<< AISPACE-TEMPLATE-ONLY
