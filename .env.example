# Copiază acest fișier în .env (la rădăcina proiectului) și completează
# cheile de care ai nevoie. .env e gitignored — nu ajunge niciodată în git.
# Scripturile din my-context/scripts/ îl citesc automat dacă există.

# Implicit pentru generare de imagini (image-generation.md) și video
# (video-generation.md) — platform.openai.com/api-keys
OPENAI_API_KEY=

# Pentru fotorealism (image-generation.md) — Flux, Black Forest Labs —
# cheia se ia din dashboard-ul lor (bfl.ai) sau din Replicate/fal.ai dacă
# rulezi Flux prin unul din ele în loc de API-ul direct BFL.
BFL_API_KEY=

# Implicit pentru generare de voce/audio (audio-voice-generation.md) —
# elevenlabs.io (doar dacă se folosește ElevenLabs, nu OpenAI TTS)
ELEVENLABS_API_KEY=
